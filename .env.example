BUSINESS_DB_HOST=10.0.0.16
BUSINESS_DB_PORT=5433
BUSINESS_DB_NAME=business
BUSINESS_DB_USER=brian_admin
BUSINESS_DB_PASSWORD=

# Synology-synced Business folder (root for the manual loaders' default input paths).
# MacBook default (used when unset):
#   ENR_BUSINESS_ROOT=/Users/bnieco/Library/CloudStorage/SynologyDrive-HomeSync/Documents/Business
# On the M6 Mac mini the same contents sync directly to the CloudStorage folder:
#   ENR_BUSINESS_ROOT=/Users/bnieco/Library/CloudStorage/SynologyDrive-HomeSync
# ENR_BUSINESS_ROOT=/Users/bnieco/Library/CloudStorage/SynologyDrive-HomeSync/Documents/Business

# Optional override for the Etsy CSV ingestion directory (scripts/load_etsy.py).
# Default derives from ENR_BUSINESS_ROOT: ${ENR_BUSINESS_ROOT}/_Data/ENR/Etsy
# ETSY_DATA_DIR=/Users/bnieco/Library/CloudStorage/SynologyDrive-HomeSync/Documents/Business/_Data/ENR/Etsy

# GA4 BigQuery export (read source for scripts/load_ga4.py)
GA4_BQ_PROJECT=elders-nine-relics
GA4_BQ_DATASET=analytics_XXXXXXXXX
GA4_SA_KEY_PATH=./elders-nine-relics-bq-service-account.json

# Etsy Open API v3 (read source for scripts/etsy_api.py)
# Keystring + shared secret come from the registered app (etsy.com/developers).
# SHOP_ID is resolved once on the first live run (then persist it here).
# REFRESH_TOKEN is written by `python scripts/etsy_api.py authorize` (one-time).
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_REDIRECT_URI=http://localhost:3003/oauth/redirect
ETSY_REFRESH_TOKEN=
